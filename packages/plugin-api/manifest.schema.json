{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sawhorse3d.com/schemas/plugin-manifest-1.json",
  "title": "Sawhorse plugin manifest (plugin.json), API 1",
  "description": "What a plugin is, what it may do and what it adds. The app's validator (packages/plugin-api/src/manifest.ts) checks the same rules and a few the schema cannot say (a menu or shortcut naming a declared command, \"ui\" needed for any contribution, \"net\" hosts only with the \"net\" permission).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "api", "description", "author", "license", "permissions"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "Reverse-DNS, lower case: org.example.cabinet-generator",
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version": {
      "description": "Semantic version",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "api": { "const": 1 },
    "description": { "type": "string", "maxLength": 500 },
    "author": { "type": "string", "minLength": 1, "maxLength": 100 },
    "license": { "description": "An SPDX licence expression: MIT, Apache-2.0 ...", "type": "string", "minLength": 1, "maxLength": 64 },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["model.read", "model.write", "ui", "storage", "file", "net"] }
    },
    "net": {
      "description": "Hosts the net permission reaches (no scheme, port or path); *.example.com for subdomains",
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$|^localhost$" }
    },
    "entry": {
      "description": "The ES module the app loads, relative to the plugin folder",
      "type": "string",
      "default": "main.js",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9_\\-./]+\\.m?js$"
    },
    "homepage": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": { "id": { "$ref": "#/$defs/cid" }, "title": { "type": "string", "minLength": 1, "maxLength": 64 } }
          }
        },
        "panels": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": { "id": { "$ref": "#/$defs/cid" }, "title": { "type": "string", "minLength": 1, "maxLength": 64 } }
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/cid" },
              "title": { "type": "string", "minLength": 1, "maxLength": 32 },
              "hint": { "type": "string", "minLength": 1, "maxLength": 200 },
              "vcb": { "description": "The Value Control Box label while the tool is active", "type": "string", "minLength": 1, "maxLength": 40 },
              "icon": { "description": "SVG path data in a 24 x 24 box", "type": "string", "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE.,\\-+\\s]{1,2000}$" }
            }
          }
        },
        "menus": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": { "command": { "$ref": "#/$defs/cid" }, "group": { "type": "string", "minLength": 1, "maxLength": 32 } }
          }
        },
        "shortcuts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "oneOf": [{ "required": ["command"] }, { "required": ["tool"] }],
            "properties": {
              "command": { "$ref": "#/$defs/cid" },
              "tool": { "$ref": "#/$defs/cid" },
              "key": { "type": "string", "pattern": "^((Ctrl|Alt|Shift|Meta)\\+)+([A-Z0-9]|F([1-9]|1[0-2]))$" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "cid": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" }
  }
}
